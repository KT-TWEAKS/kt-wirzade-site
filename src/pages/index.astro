---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';

const principles = [
  { number: '01', title: 'Detectar', text: 'O painel lê o estado atual antes de sugerir qualquer mudança.' },
  { number: '02', title: 'Revisar', text: 'Risco, requisito e efeito aparecem antes da confirmação.' },
  { number: '03', title: 'Aplicar', text: 'Ações protegidas passam por tipos, UAC e registro de progresso.' },
  { number: '04', title: 'Recuperar', text: 'Snapshots e histórico deixam o caminho de volta visível.' },
];

const flowDetails = [
  { label: 'LEITURA DO SISTEMA', text: 'O app começa pelo estado atual: requisitos, contexto e possíveis impactos aparecem antes de qualquer confirmação.', link: '/docs/fluxo-apbx', action: 'Ver o fluxo completo' },
  { label: 'DECISÃO INFORMADA', text: 'O playbook mostra suas ações, avisos e dependências. Você pode interromper a leitura sem alterar o computador.', link: '/docs/seguranca', action: 'Revisar segurança' },
  { label: 'EXECUÇÃO PROTEGIDA', text: 'A aplicação segue tipos e parâmetros permitidos, com elevação controlada, progresso visível e registro da sessão.', link: '/docs/instalar-playbooks', action: 'Abrir guia de instalação' },
  { label: 'CAMINHO DE VOLTA', text: 'O histórico local organiza o que aconteceu e mantém o rollback perto da decisão quando a operação for recuperável.', link: '/docs/rollback', action: 'Entender rollback' },
];

const layers = [
  { number: '01', label: 'HOST', title: 'Aplicativo nativo', text: 'A execução fica no computador, com elevação controlada pelo Windows.' },
  { number: '02', label: 'IPC', title: 'Comandos validados', text: 'A interface não envia comandos livres para o processo elevado.' },
  { number: '03', label: 'STATE', title: 'Snapshots locais', text: 'O estado anterior é registrado para facilitar a recuperação.' },
  { number: '04', label: 'VIEW', title: 'Interface clara', text: 'Cada ação mostra o que será alterado, sem promessas de desempenho inventadas.' },
];

const capabilities = [
  ['Playbooks .apbx', 'Pacotes declarativos para organizar alterações do Windows com leitura e auditoria antes da execução.'],
  ['Rollback granular', 'O histórico local separa operações recuperáveis, pendências e conflitos externos.'],
  ['Modo ISO', 'Fluxos para Windows 10, Windows 11 e imagens locais, com avisos de compatibilidade.'],
  ['APBX Developer', 'Analise estrutura, comandos, serviços, arquivos, downloads e riscos antes de aplicar.'],
];
---

<BaseLayout
  title="KT WIRZADE — Windows mais claro, reversível e seu"
  description="KT WIRZADE é um toolkit aberto para entender, ajustar e recuperar o Windows 10 e 11 usando playbooks APBX, validação e histórico local."
  ogDescription="Entenda o que muda no Windows antes de aplicar. Playbooks APBX, validação, snapshots e recuperação local."
>
  <Fragment slot="meta">
    <meta name="keywords" content="KT WIRZADE, KT TWEAKS, APBX, Windows, rollback, playbooks, segurança">
    <meta name="author" content="KT TWEAKS">
    <meta name="robots" content="index, follow">
  </Fragment>

  <div class="site-page">
    <Nav />
    <main>
      <section class="hero" id="top">
        <div class="hero-gridline" aria-hidden="true"></div>
        <div class="hero-copy" data-reveal="left">
          <p class="eyebrow"><i></i> WINDOWS TOOLKIT / VERSÃO PÚBLICA 1.0.1</p>
          <h1>Seu Windows.<br /><em>Mais claro.</em><br />Mais reversível.</h1>
          <p class="hero-lead">O KT WIRZADE transforma ajustes de sistema em um fluxo que você consegue ler, revisar e recuperar. Sem caixa-preta: cada etapa tem contexto, requisito e histórico.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://github.com/KT-TWEAKS/KT-WIRZADE/releases/download/v1.0.1/KT-WIRZADE-v1.0.1-win-x64.exe" target="_blank" rel="noopener"><i class="fas fa-download"></i> Baixar versão 1.0.1 <span>↗</span></a>
            <a class="button button-ghost" href="#produto">Conhecer o produto <span>↓</span></a>
          </div>
          <div class="hero-note"><span class="note-dot"></span><span>Windows 10/11 x64</span><span>·</span><span>código aberto</span><span>·</span><span>PT-BR</span></div>
        </div>
        <div class="hero-visual" data-reveal="right">
          <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
          <figure class="app-window">
            <img class="app-shot" src="/img/kt-wirzade-1.0.1.png" alt="Interface real do KT WIRZADE 1.0.1 com playbooks e estado do sistema" loading="eager" width="800" height="540" />
            <figcaption class="visual-caption"><span>CAPTURA REAL / 1.0.1</span><span>KT WIRZADE</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="signal-strip" aria-label="Resumo do produto"><div><b>10/11</b><span>Windows suportado</span></div><div><b>APBX</b><span>playbooks declarativos</span></div><div><b>LOCAL</b><span>snapshots e histórico</span></div><div><b>OPEN</b><span>código para revisar</span></div></section>

      <section class="section intro-section" id="produto">
        <div class="section-heading" data-reveal="left"><p class="kicker">O PRODUTO / 01</p><h2>Uma camada de clareza entre você e o sistema.</h2><p>O KT WIRZADE não promete “mais FPS” por mágica. Ele mostra mudanças concretas, respeita confirmações e mantém o caminho de recuperação próximo da decisão.</p><a class="text-link" href="/docs">Explorar documentação <i class="fas fa-arrow-right"></i></a></div>
        <div class="principle-list" data-reveal="right">{principles.map((item) => <article><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
      </section>

      <section class="section dark-section" id="como-funciona">
        <div class="section-heading light" data-reveal="left"><p class="kicker">FLUXO / 02</p><h2>Leia. Decida.<br /><em>Recupere.</em></h2><p>O produto organiza o processo em quatro momentos, para que o ajuste não vire um salto no escuro.</p></div>
        <div class="flow-interactive" data-reveal="right">
          <div class="flow-board" role="tablist" aria-label="Etapas do KT WIRZADE">{principles.map((item, index) => <button class:list={['flow-step', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`flow-panel-${index}`} data-flow-step={index}><span>0{index + 1}</span><div class="flow-line"></div><h3>{item.title}</h3><p>{item.text}</p></button>)}</div>
          <div class="flow-detail" aria-live="polite">{flowDetails.map((detail, index) => <div id={`flow-panel-${index}`} class="flow-panel" data-flow-panel={index} role="tabpanel" hidden={index !== 0}><span>{detail.label}</span><strong>{detail.text}</strong><a href={detail.link}>{detail.action} <i class="fas fa-arrow-right"></i></a></div>)}</div>
        </div>
      </section>

      <section class="section architecture-section" id="arquitetura">
        <div class="section-heading" data-reveal="left"><p class="kicker">ARQUITETURA / 03</p><h2>Quatro camadas.<br />Uma fronteira clara.</h2><p>A interface é apenas a parte visível. O restante existe para limitar o que pode acontecer e deixar evidências depois.</p></div>
        <div class="layer-stack" data-reveal="right">{layers.map((layer) => <article><span class="layer-number">{layer.number}</span><div><small>{layer.label}</small><h3>{layer.title}</h3><p>{layer.text}</p></div><i class="fas fa-arrow-up-right-from-square"></i></article>)}</div>
        <aside class="safety-card" data-reveal><span>REGRA CENTRAL</span><strong>A interface nunca envia comandos livres para o processo elevado.</strong><p>Operações protegidas possuem tipos e parâmetros limitados, confirmação nativa e verificação posterior.</p></aside>
      </section>

      <section class="section capability-section" id="recursos">
        <div class="section-heading" data-reveal><p class="kicker">RECURSOS / 04</p><h2>Ferramentas para trabalhar com intenção.</h2></div>
        <div class="capability-grid">{capabilities.map(([title, text], index) => <article data-reveal><span>0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </section>

      <section class="section apbx-section" id="playbooks">
        <div class="apbx-copy" data-reveal="left"><p class="kicker">APBX / 05</p><h2>Playbooks que você consegue abrir antes de executar.</h2><p>O formato APBX concentra a intenção de cada alteração em um pacote auditável. Use o catálogo público para descobrir versões e o KT WIRZADE para revisar e aplicar no computador.</p><div class="apbx-actions"><a class="button button-primary" href="https://kt-tweaks-apbx.vercel.app" target="_blank" rel="noopener">Abrir catálogo APBX <span>↗</span></a><a class="text-link" href="/docs/apbx-developer">Ler sobre APBX <i class="fas fa-arrow-right"></i></a></div></div>
        <div class="code-card" data-reveal="right"><div class="code-top"><span><i></i><i></i><i></i></span><small>playbook.yml</small><b>APBX / REVIEW</b></div><pre><code><span class="code-comment"># uma alteração explícita e revisável</span>
<span class="code-key">-</span> <span class="code-fn">!registryValue</span>:
    <span class="code-prop">path</span>: <span class="code-string">HKLM\\Software\\Policies</span>
    <span class="code-prop">value</span>: <span class="code-string">AllowTelemetry</span>
    <span class="code-prop">data</span>: <span class="code-number">0</span>
    <span class="code-prop">type</span>: <span class="code-string">REG_DWORD</span>
<span class="code-key">-</span> <span class="code-fn">!service</span>:
    <span class="code-prop">name</span>: <span class="code-string">DiagTrack</span>
    <span class="code-prop">operation</span>: <span class="code-string">disable</span></code></pre><div class="code-foot"><span><i></i> parser ready</span><span>SHA-256 / checked</span></div></div>
      </section>

      <section class="section documentation-section" id="documentacao"><div class="doc-card" data-reveal><div><p class="kicker">GUIA / 06</p><h2>Não aplique no escuro.</h2><p>Veja o fluxo público APBX → WIRZADE, instalação, limites de rollback, modo ISO, segurança e perguntas frequentes.</p></div><div class="doc-links"><a href="/docs/fluxo-apbx"><span>01</span> Fluxo APBX <i class="fas fa-arrow-right"></i></a><a href="/docs"><span>02</span> Visão geral <i class="fas fa-arrow-right"></i></a><a href="/docs/seguranca"><span>03</span> Segurança <i class="fas fa-arrow-right"></i></a><a href="/docs/rollback"><span>04</span> Rollback <i class="fas fa-arrow-right"></i></a></div></div></section>

      <section class="download-band" id="download" data-reveal><div><p class="kicker">RELEASE PÚBLICA / 1.0.1</p><h2>Seu sistema continua sendo seu.</h2><p>Baixe pela release oficial, confira a origem e leia o playbook antes de executar.</p></div><a class="button button-dark" href="https://github.com/KT-TWEAKS/KT-WIRZADE/releases/download/v1.0.1/KT-WIRZADE-v1.0.1-win-x64.exe" target="_blank" rel="noopener">Baixar para Windows <span>↗</span></a></section>
    </main>
    <Footer />
  </div>
  <script is:inline src="/js/main.js"></script>
</BaseLayout>
