---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';

const principles = [
  { number: '01', title: 'Detectar', text: 'O painel lê o estado atual antes de sugerir qualquer mudança.', icon: 'fa-crosshairs' },
  { number: '02', title: 'Revisar', text: 'Risco, requisito e efeito aparecem antes da confirmação.', icon: 'fa-magnifying-glass' },
  { number: '03', title: 'Aplicar', text: 'Ações protegidas passam por tipos, UAC e registro de progresso.', icon: 'fa-shield-halved' },
  { number: '04', title: 'Recuperar', text: 'Snapshots e histórico deixam o caminho de volta visível.', icon: 'fa-rotate-left' },
];

const flowDetails = [
  { label: 'LEITURA DO SISTEMA', text: 'O app começa pelo estado atual: requisitos, contexto e possíveis impactos aparecem antes de qualquer confirmação.', metric: 'nenhuma mudança aplicada', link: '/docs/fluxo-apbx', action: 'Ver o fluxo completo' },
  { label: 'DECISÃO INFORMADA', text: 'O playbook mostra suas ações, avisos e dependências. Você pode interromper a leitura sem alterar o computador.', metric: 'revisão antes da execução', link: '/docs/seguranca', action: 'Revisar segurança' },
  { label: 'EXECUÇÃO PROTEGIDA', text: 'A aplicação segue tipos e parâmetros permitidos, com elevação controlada, progresso visível e registro da sessão.', metric: 'progresso + logs locais', link: '/docs/instalar-playbooks', action: 'Abrir guia de instalação' },
  { label: 'CAMINHO DE VOLTA', text: 'O histórico local organiza o que aconteceu e mantém o rollback perto da decisão quando a operação for recuperável.', metric: 'recuperação quando suportada', link: '/docs/rollback', action: 'Entender rollback' },
];

const layers = [
  { number: '01', label: 'HOST', title: 'Aplicativo nativo', text: 'A execução fica no computador, com elevação controlada pelo Windows.', icon: 'fa-desktop' },
  { number: '02', label: 'IPC', title: 'Comandos validados', text: 'A interface não envia comandos livres para o processo elevado.', icon: 'fa-arrow-right-arrow-left' },
  { number: '03', label: 'STATE', title: 'Snapshots locais', text: 'O estado anterior é registrado para facilitar a recuperação.', icon: 'fa-database' },
  { number: '04', label: 'VIEW', title: 'Interface clara', text: 'Cada ação mostra o que será alterado, sem promessas de desempenho inventadas.', icon: 'fa-eye' },
];

const capabilities = [
  ['fa-cubes', 'Playbooks .apbx', 'Pacotes declarativos para organizar alterações do Windows com leitura e auditoria antes da execução.'],
  ['fa-rotate-left', 'Rollback granular', 'O histórico local separa operações recuperáveis, pendências e conflitos externos.'],
  ['fa-compact-disc', 'Modo ISO', 'Fluxos para Windows 10, Windows 11 e imagens locais, com avisos de compatibilidade.'],
  ['fa-code', 'APBX Developer', 'Analise estrutura, comandos, serviços, arquivos, downloads e riscos antes de aplicar.'],
];
---

<BaseLayout
  title="KT WIRZADE — Windows mais claro, reversível e seu"
  description="KT WIRZADE é um toolkit aberto para entender, ajustar e recuperar o Windows 10 e 11 usando playbooks APBX, validação e histórico local."
  ogDescription="Entenda o que muda no Windows antes de aplicar. Playbooks APBX, validação, snapshots e recuperação local."
>
  <Fragment slot="meta">
    <meta name="keywords" content="KT WIRZADE, KT TWEAKS, APBX, Windows, rollback, playbooks, segurança">
    <meta name="author" content="KT TWEAKS">
    <meta name="robots" content="index, follow">
  </Fragment>

  <div class="site-page">
    <Nav />
    <main>
      <section class="hero" id="top">
        <div class="hero-gridline" aria-hidden="true"></div>
        <div class="hero-copy" data-reveal="left">
          <p class="eyebrow"><i></i> WINDOWS TOOLKIT / VERSÃO PÚBLICA 1.0.1</p>
          <h1>Seu Windows.<br /><em>Mais claro.</em><br />Mais reversível.</h1>
          <p class="hero-lead">O KT WIRZADE transforma ajustes de sistema em um fluxo que você consegue ler, revisar e recuperar. Sem caixa-preta: cada etapa tem contexto, requisito e histórico.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://github.com/KT-TWEAKS/KT-WIRZADE/releases/download/v1.0.1/KT-WIRZADE-v1.0.1-win-x64.exe" target="_blank" rel="noopener"><i class="fas fa-download"></i> Baixar versão 1.0.1 <span>↗</span></a>
            <a class="button button-ghost" href="#produto">Conhecer o produto <span>↓</span></a>
          </div>
          <div class="hero-note"><span class="note-dot"></span><span>Windows 10/11 x64</span><span>·</span><span>código aberto</span><span>·</span><span>PT-BR</span></div>
        </div>
        <div class="hero-visual" data-reveal="right">
          <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
          <figure class="app-window" data-tilt data-spotlight>
            <img class="app-shot" src="/img/kt-wirzade-1.0.1.png" alt="Interface real do KT WIRZADE 1.0.1 com playbooks e estado do sistema" loading="eager" width="800" height="540" />
            <figcaption class="visual-caption"><span>CAPTURA REAL / 1.0.1</span><span>KT WIRZADE</span></figcaption>
          </figure>
          <div class="hero-live-card" aria-label="Estado da release pública"><i class="fas fa-circle-check" aria-hidden="true"></i><span><small>PUBLIC RELEASE</small><b>1.0.1 · SHA-256 checked</b></span></div>
        </div>
      </section>

      <section class="signal-strip" aria-label="Resumo do produto"><div><i class="fab fa-windows" aria-hidden="true"></i><b>10/11</b><span>Windows suportado</span></div><div><i class="fas fa-cubes" aria-hidden="true"></i><b>APBX</b><span>playbooks declarativos</span></div><div><i class="fas fa-clock-rotate-left" aria-hidden="true"></i><b>LOCAL</b><span>snapshots e histórico</span></div><div><i class="fas fa-code-branch" aria-hidden="true"></i><b>OPEN</b><span>código para revisar</span></div></section>

      <section class="section intro-section" id="produto">
        <div class="section-heading" data-reveal="left"><p class="kicker">O PRODUTO / 01</p><h2>Uma camada de clareza entre você e o sistema.</h2><p>O KT WIRZADE não promete “mais FPS” por mágica. Ele mostra mudanças concretas, respeita confirmações e mantém o caminho de recuperação próximo da decisão.</p><a class="text-link" href="/docs">Explorar documentação <i class="fas fa-arrow-right"></i></a></div>
        <div class="principle-list" data-reveal="right">{principles.map((item) => <article data-spotlight><span class="principle-icon"><i class={`fas ${item.icon}`} aria-hidden="true"></i></span><div><small class="principle-number">{item.number}</small><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
      </section>

      <section class="section dark-section flow-showcase" id="como-funciona">
        <div class="section-heading light flow-heading" data-reveal="left">
          <div class="flow-kicker-line"><p class="kicker">FLUXO / 02</p><span class="flow-live"><i></i> MOTOR LOCAL</span></div>
          <h2>Leia antes.<br /><em>Decida melhor.</em></h2>
          <p>O WIRZADE transforma um ajuste de sistema em uma sequência visível: primeiro você entende, depois confirma, e só então aplica.</p>
          <div class="flow-readout" aria-live="polite"><div><span class="flow-readout-dot"></span><small data-flow-status>ETAPA 01 / LEITURA DO SISTEMA</small></div><strong data-flow-headline>Nenhuma alteração começa sem contexto.</strong></div>
          <div class="flow-mini-grid"><div><i class="fas fa-eye"></i><span><small>ANTES</small><b>ler</b></span></div><div><i class="fas fa-fingerprint"></i><span><small>DURANTE</small><b>registrar</b></span></div><div><i class="fas fa-rotate-left"></i><span><small>DEPOIS</small><b>recuperar</b></span></div></div>
          <a class="text-link" href="/docs/fluxo-apbx">Abrir o mapa APBX completo <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="flow-interactive flow-console" data-reveal="right" data-spotlight>
          <div class="flow-console-top"><span class="console-lights"><i></i><i></i><i></i></span><span>KT WIRZADE / CONTROL FLOW</span><b><i class="fas fa-circle-check"></i> READY</b></div>
          <div class="flow-console-body">
            <div class="flow-rail" aria-hidden="true"><span class="flow-rail-track"></span><span class="flow-rail-fill" data-flow-progress></span></div>
            <div class="flow-board" role="tablist" aria-label="Etapas do KT WIRZADE">{principles.map((item, index) => <button class:list={['flow-step', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`flow-panel-${index}`} data-flow-step={index}><span class="flow-step-index">0{index + 1}</span><span class="flow-step-copy"><span class="flow-step-top"><i class={`flow-icon fas ${item.icon}`} aria-hidden="true"></i><small>{index === 0 ? 'INPUT' : index === 1 ? 'REVIEW' : index === 2 ? 'APPLY' : 'RECOVERY'}</small></span><strong>{item.title}</strong><em>{item.text}</em></span><i class="flow-step-arrow fas fa-arrow-right" aria-hidden="true"></i></button>)}</div>
            <div class="flow-detail" aria-live="polite">{flowDetails.map((detail, index) => <div id={`flow-panel-${index}`} class="flow-panel" data-flow-panel={index} role="tabpanel" hidden={index !== 0}><div class="flow-panel-head"><span class="flow-panel-icon"><i class={`fas ${principles[index].icon}`} aria-hidden="true"></i></span><div><span>{detail.label}</span><small>CHECKPOINT 0{index + 1} / 04</small></div></div><strong>{detail.text}</strong><div class="flow-panel-foot"><span><i class="fas fa-circle-check"></i> {detail.metric}</span><a href={detail.link}>{detail.action} <i class="fas fa-arrow-right"></i></a></div></div>)}</div>
          </div>
          <div class="flow-console-foot"><span><i class="fas fa-lock"></i> execução local</span><span><i class="fas fa-wave-square"></i> estado sincronizado</span><span>APBX → WIRZADE</span></div>
        </div>
      </section>

      <section class="section architecture-section" id="arquitetura">
        <div class="section-heading" data-reveal="left"><p class="kicker">ARQUITETURA / 03</p><h2>Quatro camadas.<br />Uma fronteira clara.</h2><p>A interface é apenas a parte visível. O restante existe para limitar o que pode acontecer e deixar evidências depois.</p></div>
        <div class="layer-stack" data-reveal="right">{layers.map((layer) => <article data-spotlight><span class="layer-number">{layer.number}</span><div><small><i class={`fas ${layer.icon}`} aria-hidden="true"></i> {layer.label}</small><h3>{layer.title}</h3><p>{layer.text}</p></div><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></article>)}</div>
        <aside class="safety-card" data-reveal data-spotlight><span>REGRA CENTRAL</span><strong>A interface nunca envia comandos livres para o processo elevado.</strong><p>Operações protegidas possuem tipos e parâmetros limitados, confirmação nativa e verificação posterior.</p></aside>
      </section>

      <section class="section capability-section" id="recursos">
        <div class="section-heading" data-reveal><p class="kicker">RECURSOS / 04</p><h2>Ferramentas para trabalhar com intenção.</h2></div>
        <div class="capability-grid">{capabilities.map(([icon, title, text], index) => <article data-reveal data-spotlight><span class="capability-icon"><i class={`fas ${icon}`} aria-hidden="true"></i></span><div><small>0{index + 1}</small><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </section>

      <section class="section apbx-section" id="playbooks">
        <div class="apbx-copy" data-reveal="left"><p class="kicker">APBX / 05</p><h2>Playbooks que você consegue abrir antes de executar.</h2><p>O formato APBX concentra a intenção de cada alteração em um pacote auditável. Use o catálogo público para descobrir versões e o KT WIRZADE para revisar e aplicar no computador.</p><div class="apbx-actions"><a class="button button-primary" href="https://kt-tweaks-apbx.vercel.app" target="_blank" rel="noopener">Abrir catálogo APBX <span>↗</span></a><a class="text-link" href="/docs/apbx-developer">Ler sobre APBX <i class="fas fa-arrow-right"></i></a></div></div>
        <div class="code-card" data-reveal="right"><div class="code-top"><span><i></i><i></i><i></i></span><small>playbook.yml</small><b>APBX / REVIEW</b></div><pre><code><span class="code-comment"># uma alteração explícita e revisável</span>
<span class="code-key">-</span> <span class="code-fn">!registryValue</span>:
    <span class="code-prop">path</span>: <span class="code-string">HKLM\\Software\\Policies</span>
    <span class="code-prop">value</span>: <span class="code-string">AllowTelemetry</span>
    <span class="code-prop">data</span>: <span class="code-number">0</span>
    <span class="code-prop">type</span>: <span class="code-string">REG_DWORD</span>
<span class="code-key">-</span> <span class="code-fn">!service</span>:
    <span class="code-prop">name</span>: <span class="code-string">DiagTrack</span>
    <span class="code-prop">operation</span>: <span class="code-string">disable</span></code></pre><div class="code-foot"><span><i></i> parser ready</span><span>SHA-256 / checked</span></div></div>
      </section>

      <section class="section documentation-section" id="documentacao"><div class="doc-card" data-reveal data-spotlight><div><p class="kicker">GUIA / 06</p><h2>Não aplique no escuro.</h2><p>Veja o fluxo público APBX → WIRZADE, instalação, limites de rollback, modo ISO, segurança, perguntas frequentes e desenvolvimento.</p></div><div class="doc-links"><a href="/docs/fluxo-apbx"><span>01</span> Fluxo APBX <i class="fas fa-arrow-right"></i></a><a href="/docs"><span>02</span> Visão geral <i class="fas fa-arrow-right"></i></a><a href="/docs/seguranca"><span>03</span> Segurança <i class="fas fa-arrow-right"></i></a><a href="/docs/developer"><span>04</span> Guia developer <i class="fas fa-arrow-right"></i></a></div></div></section>

      <section class="download-band" id="download" data-reveal><div><p class="kicker">RELEASE PÚBLICA / 1.0.1</p><h2>Seu sistema continua sendo seu.</h2><p>Baixe pela release oficial, confira a origem e leia o playbook antes de executar.</p></div><a class="button button-dark" href="https://github.com/KT-TWEAKS/KT-WIRZADE/releases/download/v1.0.1/KT-WIRZADE-v1.0.1-win-x64.exe" target="_blank" rel="noopener">Baixar para Windows <span>↗</span></a></section>
    </main>
    <Footer />
  </div>
  <script is:inline src="/js/main.js"></script>
</BaseLayout>
